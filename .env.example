# GenLayer Bradbury Testnet
# Fill these in after deploying lemma.py and grabbing the contract address.

# The deployed Lemma contract address on Bradbury (0x-prefixed).
NEXT_PUBLIC_LEMMA_CONTRACT=

# Local deploy/smoke only. Never put this value in Vercel or commit it.
# Use a funded Bradbury testnet deploy account private key.
GENLAYER_PRIVATE_KEY=

# Optional but recommended for smoke diagnostics: the deploy tx hash printed
# by `npm run deploy:bradbury`.
LEMMA_DEPLOY_TX=

# Bradbury RPC endpoint. The official URL is set in genlayer-js/chains;
# only override this if you are running a custom RPC node.
# NEXT_PUBLIC_BRADBURY_RPC=

# Optional: the canonical site origin used in OG images and citation strings.
NEXT_PUBLIC_SITE_URL=https://uselemma.xyz

# Optional: GitHub repo URL surfaced in the footer.
NEXT_PUBLIC_REPO_URL=https://github.com/Zhekinmaksim/lemma
